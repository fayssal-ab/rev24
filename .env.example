# GROUP22 — copier en .env.local pour le développement (jamais committé).
# Sur Netlify, mettre ces mêmes variables dans Site configuration → Environment variables.

# Interface : "on" = un compte est obligatoire
VITE_AUTH=on

# Aiven → service MySQL → Service URI (avec le vrai mot de passe)
DATABASE_URL=mysql://avnadmin:MOT_DE_PASSE@mysql-xxxx.aivencloud.com:25783/defaultdb
# Aiven → CA certificate (le texte complet, sur une ligne avec \n ou tel quel sur Netlify)
DB_CA_CERT=
# Chaîne aléatoire longue (ex. : openssl rand -base64 48)
JWT_SECRET=
# E-mails qui voient le coach de présentation orale (facultatif)
ORAL_EMAILS=fayssal.abaibat@emsi-edu.ma
# Administrateurs (dashboard /admin, approbation des comptes)
ADMIN_EMAILS=fayssal.abaibat@emsi-edu.ma
# Développement avec une base locale sans TLS uniquement :
# DB_SSL=off
