    "body": {
     "fr": "Écarts : −4, −2, −2, 0, 1, 7 → carrés 16, 4, 4, 0, 1, 49 → somme **74**.",
     "dar": "Σ(x − x̄)² = **74**.",
     "en": "Σ(x − x̄)² = **74**."
    },
    "tex": "V = \\frac{74}{6} \\approx 12{,}33 \\quad \\sigma \\approx 3{,}51 \\qquad S^2 = \\frac{74}{5} = 14{,}8 \\quad S \\approx 3{,}85"
   },
   {
    "title": {
     "fr": "3) Quartiles",
     "dar": "3) Quartiles",
     "en": "3) Quartiles"
