  },
  "statement": {
   "fr": "Notes d'un groupe de 20 étudiants :\n\n| Note xi | 8 | 10 | 12 | 14 |\n|---|---|---|---|---|\n| Effectif ni | 2 | 5 | 8 | 5 |\n\nCalculer la moyenne, la variance (diviseur n) et l'écart-type. Donner le mode.",
   "dar": "Notes dyal 20 talib : xi = 8, 10, 12, 14 ; ni = 2, 5, 8, 5. 7seb moyenne, variance (n), écart-type w mode.",
   "en": "Marks of 20 students: xi = 8, 10, 12, 14; ni = 2, 5, 8, 5. Compute mean, variance (n), SD and mode."
  },
  "hints": [
   {
    "fr": "Moyenne pondérée : Σ ni·xi / n.",
    "dar": "Σ ni·xi / n.",
    "en": "Σ ni·xi / n."
   },
   {
    "fr": "Formule de König : V = Σ ni·xi² / n − x̄².",
    "dar": "König : Σ ni·xi²/n − x̄².",
    "en": "König: Σ ni·xi²/n − x̄²."
   }
  ],
  "solutionSteps": [
   {
    "title": {
     "fr": "Effectif total",
     "dar": "Total",
     "en": "Total"
    },
    "body": {
     "fr": "n = 2 + 5 + 8 + 5 = **20**.",
     "dar": "n = **20**.",
     "en": "n = **20**."
    }
   },
   {
    "title": {
     "fr": "Moyenne",
     "dar": "Moyenne",
     "en": "Mean"
    },
    "body": {
     "fr": "Σ ni·xi = 16 + 50 + 96 + 70 = 232.",
     "dar": "Σ ni·xi = 232.",
     "en": "Σ ni·xi = 232."
    },
    "tex": "\\bar x = \\frac{232}{20} = 11{,}6"
   },
   {
    "title": {
     "fr": "Variance (König)",
     "dar": "Variance (König)",
     "en": "Variance (König)"
    },
    "body": {
     "fr": "Σ ni·xi² = 2×64 + 5×100 + 8×144 + 5×196 = 128 + 500 + 1152 + 980 = 2760.",
     "dar": "Σ ni·xi² = 2760.",
     "en": "Σ ni·xi² = 2760."
    },
    "tex": "V = \\frac{2760}{20} - 11{,}6^2 = 138 - 134{,}56 = 3{,}44 \\qquad \\sigma = \\sqrt{3{,}44} \\approx 1{,}855"
   },
   {
    "title": {
     "fr": "Mode",
     "dar": "Mode",
     "en": "Mode"
    },
    "body": {
     "fr": "Plus grand effectif (8) → Mo = **12**.",
     "dar": "Mo = **12**.",
     "en": "Mo = **12**."
    }
   }
