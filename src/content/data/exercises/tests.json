   "en": "Rocket: full two-sided test"
  },
  "statement": {
   "fr": "Une machine fabrique des pièces de fusée de longueur µ0 = 40 cm (σ = 2 cm connu). Sur n = 25 pièces, x̄ = 41,25 cm. Au risque α = 5 %, la machine est-elle déréglée ? Calcule aussi la P-value.",
   "dar": "Machine µ0 = 40, σ = 2, n = 25, x̄ = 41,25. Déréglée ? PV ?",
   "en": "Machine µ0 = 40, σ = 2, n = 25, x̄ = 41.25. Out of adjustment at 5 %? P-value?"
  },
  "hints": [
   {
    "fr": "σ connu → Z0.",
    "dar": "Z0.",
    "en": "σ known → Z0."
   },
   {
    "fr": "« Déréglée » = différente de 40, dans un sens ou l'autre → bilatéral.",
    "dar": "Bilatéral.",
    "en": "Two-sided."
   }
  ],
  "solutionSteps": [
   {
    "title": {
     "fr": "Hypothèses",
     "dar": "Hypothèses",
     "en": "Hypotheses"
    },
    "body": {
     "fr": "H0 : µ = 40 ; H1 : µ ≠ 40 ; α = 5 %.",
     "dar": "H0 µ = 40, H1 µ ≠ 40.",
     "en": "H0: µ = 40; H1: µ ≠ 40."
    }
   },
   {
    "title": {
     "fr": "Statistique",
     "dar": "Statistique",
     "en": "Statistic"
    },
    "body": {
     "fr": "Commandes :",
     "dar": "Les commandes :",
     "en": "Commands:"
    },
    "tex": "Z_0 = \\frac{41{,}25-40}{2/\\sqrt{25}} = \\frac{1{,}25}{0{,}4} = 3{,}125"
   },
   {
    "title": {
     "fr": "Décision",
     "dar": "Qarar",
     "en": "Decision"
    },
    "body": {
     "fr": "|Z0| = 3,125 > z(0,025) = 1,96 → rejet de H0.",
     "dar": "3,125 > 1,96.",
     "en": "3.125 > 1.96 → reject."
    }
   },
   {
    "title": {
     "fr": "P-value",
     "dar": "P-value",
     "en": "P-value"
    },
    "body": {
     "fr": "PV < 0,05 confirme le rejet.",
     "dar": "PV < 0,05.",
     "en": "PV < 0.05 confirms."
    },
    "tex": "PV = 2(1-\\Phi(3{,}125)) \\approx 0{,}0018"
   }
  ],
  "finalAnswer": {
   "fr": "Z0 = 3,125 > 1,96 → on rejette H0 : la machine est déréglée (PV ≈ 0,0018).",
   "dar": "Rejet, PV ≈ 0,0018.",
   "en": "Z0 = 3.125 > 1.96 → reject H0 (PV ≈ 0.0018)."
  },
  "commonMistakes": [
   {
    "fr": "Oublier √n.",
    "dar": "Tnsa √n.",
    "en": "Forgetting √n."
   },
   {
    "fr": "Utiliser 1,645 (unilatéral).",
    "dar": "1,645.",
    "en": "Using 1.645."
   },
   {
    "fr": "Oublier ×2 dans la PV.",
    "dar": "Bla ×2.",
    "en": "Forgetting ×2."
   }
  ],
