  "kind": "numeric",
  "prompt": {
   "fr": "Test Z **bilatéral** : Z0 = 3,125. Calcule la **P-value** (4 décimales).",
   "dar": "Test Z **bilatéral** : Z0 = 3,125. 7seb **P-value** (4 décimales).",
   "en": "**Two-sided** Z test: Z0 = 3.125. Compute the **P-value** (4 decimals)."
  },
  "answer": 0.0018,
  "tolerance": 0.0002,
  "compute": {
   "fn": "pValueZ",
   "args": [
    3.125,
    "two"
