    "fr": "Tu as divisé par σ sans √n : l'écart-type de x̄ est σ/√n = 0,4.",
    "dar": "Na9es √n.",
    "en": "Forgot √n."
   },
   "1.25": {
    "fr": "C'est x̄ − µ0, il faut encore diviser par σ/√n.",
    "dar": "Khass t9sem.",
    "en": "Still divide by σ/√n."
   }
  },
  "tags": [
   "tests",
   "z"
  ]
 },
