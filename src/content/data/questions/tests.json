 {
  "id": "dt-07",
  "module": "data",
  "chapter": "tests",
  "difficulty": 2,
  "kind": "numeric",
  "prompt": {
   "fr": "Des fusées doivent atteindre en moyenne µ0 = 40 km ; σ = 2 km (connu). Sur n = 25 fusées, x̄ = 41,25 km. Calcule Z0.",
   "dar": "Fusées : µ0 = 40 km, σ = 2 (m3rouf), n = 25, x̄ = 41,25. 7seb Z0.",
   "en": "Rockets: µ0 = 40 km, σ = 2 (known), n = 25, x̄ = 41.25. Compute Z0."
  },
  "answer": 3.125,
  "tolerance": 0.01,
  "compute": {
   "fn": "zStat",
   "args": [
    41.25,
    40,
    2,
    25
   ]
  },
  "explanation": {
   "fr": "$Z_0 = \\frac{\\bar x - \\mu_0}{\\sigma/\\sqrt n} = \\frac{41{,}25 - 40}{2/5} = \\frac{1{,}25}{0{,}4} = 3{,}125$",
   "dar": "$Z_0 = 1{,}25/0{,}4 = 3{,}125$",
   "en": "$Z_0 = 1.25/0.4 = 3.125$"
  },
  "wrongExplanations": {
