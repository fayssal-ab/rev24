   "dar": "7iyed stour / colonnes",
   "en": "Drop rows / columns with NaN"
  }
 },
 {
  "id": "dn-r3",
  "chapter": "nettoyage",
  "syntax": "df['c'].fillna(df['c'].mean())",
  "desc": {
   "fr": "Imputer par la moyenne (ou .median(), .mode()[0], une valeur fixe)",
   "dar": "Imputer",
   "en": "Impute with the mean (or median, mode, fixed value)"
  }
 },
 {
  "id": "dn-r4",
  "chapter": "nettoyage",
  "syntax": "IQR = Q3 − Q1 ; aberrante si x ∉ [Q1 − 1,5·IQR ; Q3 + 1,5·IQR]",
  "desc": {
   "fr": "Méthode IQR",
   "dar": "Méthode IQR",
   "en": "IQR method"
  },
  "example": "df['c'].quantile([0.25, 0.75])"
 },
 {
  "id": "dn-r5",
  "chapter": "nettoyage",
  "syntax": "Xnorm = (X − Xmin) / (Xmax − Xmin)",
  "desc": {
   "fr": "Normalisation Min-Max",
   "dar": "Min-Max",
   "en": "Min-Max normalisation"
  },
  "example": "(df - df.min()) / (df.max() - df.min())"
 },
 {
  "id": "dn-r6",
  "chapter": "nettoyage",
  "syntax": "Xz = (X − μ) / σ",
  "desc": {
   "fr": "Standardisation Z-score",
   "dar": "Z-score",
   "en": "Z-score standardisation"
  },
  "example": "(df - df.mean()) / df.std()"
 },
 {
  "id": "dn-r7",
  "chapter": "nettoyage",
