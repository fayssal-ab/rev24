 {
  "id": "dr-r1",
  "chapter": "rappel",
  "syntax": "x̄ = Σxᵢ / n",
  "desc": {
   "fr": "Moyenne arithmétique",
   "dar": "Moyenne",
   "en": "Arithmetic mean"
  },
  "example": "df[\"x\"].mean()"
 },
 {
  "id": "dr-r2",
  "chapter": "rappel",
  "syntax": "Me = valeur du milieu (série triée)",
  "desc": {
   "fr": "Médiane",
   "dar": "Médiane",
   "en": "Median"
  },
  "example": "df[\"x\"].median()"
 },
 {
  "id": "dr-r3",
  "chapter": "rappel",
  "syntax": "V = Σ(xᵢ − x̄)² / n   ·   S² = Σ(xᵢ − x̄)² / (n − 1)",
  "desc": {
   "fr": "Variance et variance corrigée (pandas : n − 1)",
   "dar": "Variance (n) w corrigée (n − 1)",
   "en": "Variance and corrected variance (pandas: n − 1)"
  },
  "example": "df[\"x\"].var()  # n-1 ; df[\"x\"].var(ddof=0)  # n"
 },
 {
  "id": "dr-r4",
  "chapter": "rappel",
  "syntax": "σ = √V   ·   S = √S²",
  "desc": {
   "fr": "Écart-type",
   "dar": "Écart-type",
   "en": "Standard deviation"
  },
  "example": "df[\"x\"].std()"
 },
 {
  "id": "dr-r5",
  "chapter": "rappel",
  "syntax": "IQR = Q3 − Q1",
  "desc": {
   "fr": "Écart interquartile",
   "dar": "IQR",
   "en": "Interquartile range"
  },
  "example": "df[\"x\"].quantile(0.75) - df[\"x\"].quantile(0.25)"
 },
 {
  "id": "dr-r6",
  "chapter": "rappel",
  "syntax": "cov(x,y) = Σ(xᵢ − x̄)(yᵢ − ȳ) / n",
  "desc": {
   "fr": "Covariance",
   "dar": "Covariance",
   "en": "Covariance"
  },
  "example": "np.cov(x, y, ddof=0)"
 },
 {
  "id": "dr-r7",
  "chapter": "rappel",
  "syntax": "r = cov(x,y) / (σx σy)",
  "desc": {
   "fr": "Coefficient de corrélation linéaire",
   "dar": "Corrélation",
   "en": "Linear correlation coefficient"
  },
  "example": "df[\"x\"].corr(df[\"y\"])"
 },
 {
  "id": "dr-r8",
  "chapter": "rappel",
  "syntax": "ŷ = a x + b,  a = cov(x,y)/V(x),  b = ȳ − a x̄,  R² = r²",
  "desc": {
   "fr": "Régression linéaire (moindres carrés)",
   "dar": "Régression linéaire",
   "en": "Linear regression (least squares)"
  },
  "example": "a, b = np.polyfit(x, y, 1)"
 },
