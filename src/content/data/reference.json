 {
  "id": "r-dt-1",
  "chapter": "tests",
  "syntax": "Z0 = (x̄ − µ0)/(σ/√n)",
  "desc": {
   "fr": "σ connu",
   "dar": "σ m3rouf",
   "en": "σ known"
  }
 },
 {
  "id": "r-dt-2",
  "chapter": "tests",
  "syntax": "T0 = (x̄ − µ0)/(S/√n) ~ t(n−1)",
  "desc": {
   "fr": "σ inconnu",
   "dar": "σ ma m3roufch",
   "en": "σ unknown"
  }
 },
 {
  "id": "r-dt-3",
  "chapter": "tests",
  "syntax": "S = √(Σ(xi − x̄)²/(n−1))",
  "desc": {
   "fr": "Écart-type corrigé",
   "dar": "S",
   "en": "Corrected SD"
  }
 },
 {
  "id": "r-dt-4",
  "chapter": "tests",
  "syntax": "|Z0| > z(α/2) · Z0 < −z(α) · Z0 > z(α)",
  "desc": {
   "fr": "Régions critiques",
   "dar": "Régions",
   "en": "Critical regions"
  }
 },
 {
  "id": "r-dt-5",
  "chapter": "tests",
  "syntax": "PV = 2(1−Φ(|Z0|)) · Φ(Z0) · 1−Φ(Z0)",
  "desc": {
   "fr": "P-values ; rejet si α > PV",
   "dar": "PV",
   "en": "P-values"
  }
 },
 {
  "id": "r-dt-6",
  "chapter": "tests",
  "syntax": "z : 1,282 · 1,645 · 1,96 · 2,054 · 2,326 · 2,576",
  "desc": {
   "fr": "10 %, 5 %, 2,5 %, 2 %, 1 %, 0,5 %",
   "dar": "Seuils",
   "en": "Upper quantiles"
  }
 },
 {
  "id": "r-dt-7",
  "chapter": "tests",
  "syntax": "χ² = Σ(Oi − Ei)²/Ei ; Ei = n·pi ; ν = k − p − 1",
  "desc": {
   "fr": "Ajustement du χ²",
   "dar": "χ²",
   "en": "χ² fit"
  }
 },
 {
  "id": "r-dt-8",
  "chapter": "tests",
  "syntax": "χ²(0,05) : 3,841 · 5,991 · 7,815 · 9,488 · 11,070",
  "desc": {
   "fr": "ν = 1, 2, 3, 4, 5",
   "dar": "ν = 1, 2, 3, 4, 5",
   "en": "ν = 1, 2, 3, 4, 5"
  }
 },
 {
  "id": "r-dt-9",
  "chapter": "tests",
  "syntax": "α = P(rejeter H0 | H0 vraie) · β = P(accepter H0 | H0 fausse) · puissance = 1 − β",
  "desc": {
   "fr": "Erreurs de type I et II, puissance du test",
   "dar": "Ghalat naw3 I w II, puissance",
   "en": "Type I and II errors, power"
  }
 },
 {
  "id": "r-dt-10",
  "chapter": "tests",
  "syntax": "Z ~ N(0, 1) : Φ(z) = P(Z ≤ z), Φ(−z) = 1 − Φ(z), P(Z > zα) = α",
  "desc": {
   "fr": "Loi normale centrée réduite",
   "dar": "Loi normale",
   "en": "Standard normal law"
  }
 },
 {
  "id": "r-dt-11",
  "chapter": "tests",
  "syntax": "t(α ; 9) : 1,833 (5 %) · 2,262 (2,5 %) · 2,821 (1 %) · 3,250 (0,5 %)",
  "desc": {
   "fr": "Loi de Student à ν = n − 1 ddl (exemple ν = 9)",
   "dar": "Student ν = 9",
   "en": "Student law with ν = n − 1 df (ν = 9)"
  }
 },
 {
  "id": "r-dt-12",
  "chapter": "tests",
  "syntax": "H0 : θ = θ0 ; H1 : θ ≠ θ0 (bilatéral), θ < θ0 (gauche), θ > θ0 (droite)",
  "desc": {
   "fr": "Formes des hypothèses",
   "dar": "Hypothèses",
   "en": "Forms of the hypotheses"
  }
 }
