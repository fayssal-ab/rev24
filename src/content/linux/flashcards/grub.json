 {
  "id": "fc-grub-8",
  "module": "linux",
  "chapter": "grub",
  "front": {
   "fr": "Étapes reset root ?",
   "dar": "Étapes reset root ?",
   "en": "Root reset steps?"
  },
  "back": {
   "fr": "e → rd.break → Ctrl+X → mount -o remount,rw /sysroot → chroot /sysroot → passwd → touch /.autorelabel → exit ×2",
   "dar": "e → rd.break → Ctrl+X → remount → chroot → passwd → autorelabel → exit ×2",
   "en": "e → rd.break → Ctrl+X → remount rw → chroot → passwd → autorelabel → exit ×2"
  }
 },
 {
  "id": "fc-grub-9",
  "module": "linux",
  "chapter": "grub",
  "front": {
   "fr": "Pourquoi /.autorelabel ?",
   "dar": "3lach /.autorelabel ?",
   "en": "Why /.autorelabel?"
  },
  "back": {
   "fr": "Réétiqueter SELinux : /etc/shadow modifié hors contexte, sinon plus de connexion possible.",
   "dar": "SELinux : sinon ma ymkench tdkhol.",
   "en": "SELinux relabel: /etc/shadow changed out of context, otherwise no login."
  }
 },
 {
  "id": "fc-grub-10",
  "module": "linux",
  "chapter": "grub",
  "front": {
   "fr": "Protéger GRUB ?",
   "dar": "N7miw GRUB ?",
   "en": "Protect GRUB?"
  },
  "back": {
   "fr": "`grub2-setpassword` → /boot/grub2/user.cfg ; `rm` ce fichier pour retirer.",
   "dar": "`grub2-setpassword` → user.cfg.",
   "en": "`grub2-setpassword` → user.cfg; delete it to remove."
  }
 },
 {
  "id": "fc-grub-11",
  "module": "linux",
