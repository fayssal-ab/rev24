 {
  "id": "fc-pkg-7",
  "module": "linux",
  "chapter": "paquets",
  "front": {
   "fr": "rpm vs dnf ?",
   "dar": "rpm vs dnf ?",
   "en": "rpm vs dnf?"
  },
  "back": {
   "fr": "rpm : un fichier, ne résout pas les dépendances. dnf : dépôts + résolution.",
   "dar": "rpm fichier ; dnf dépôts.",
   "en": "rpm: one file, no resolution. dnf: repos + resolution."
  }
 },
 {
