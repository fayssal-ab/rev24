    "check": {
     "type": "shadowField",
     "user": "tp",
     "field": "min",
     "value": "2"
    }
   },
   {
    "label": {
     "fr": "tp : avertissement 7",
     "dar": "tp warn 7",
     "en": "tp: warn 7"
