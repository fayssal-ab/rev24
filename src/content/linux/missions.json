[
 {
  "id": "m-tp1-files",
  "module": "linux",
  "chapter": "tp1",
  "title": {
   "fr": "Fichiers et répertoires",
   "dar": "Fichiers w répertoires",
   "en": "Files and directories"
  },
  "goal": {
   "fr": "En tant qu'`etudiant` : crée `~/tp1/a/b`, écris « Revision Linux » dans `~/tp1/notes.txt`, copie-le en `~/tp1/a/copie.txt`, puis supprime le répertoire `~/brouillon` et tout son contenu.",
   "dar": "B `etudiant` : `~/tp1/a/b`, notes.txt, copie, w mse7 `~/brouillon`.",
   "en": "As `etudiant`: create `~/tp1/a/b`, write \"Revision Linux\" to `~/tp1/notes.txt`, copy it to `~/tp1/a/copie.txt`, delete `~/brouillon`."
  },
  "setup": [
   "mkdir -p /home/etudiant/brouillon/vieux",
   "touch /home/etudiant/brouillon/vieux/a.txt",
   "chown -R etudiant:etudiant /home/etudiant/brouillon"
  ],
  "startUser": "etudiant",
  "rdbreak": false,
  "engine": "bash",
  "objectives": [
   {
    "label": {
     "fr": "~/tp1/a/b existe",
     "dar": "~/tp1/a/b kayn",
     "en": "~/tp1/a/b exists"
    },
    "check": {
     "type": "pathExists",
     "path": "/home/etudiant/tp1/a/b",
     "kind": "dir"
    }
   },
   {
    "label": {
     "fr": "notes.txt contient « Revision Linux »",
     "dar": "notes.txt fih « Revision Linux »",
     "en": "notes.txt contains \"Revision Linux\""
    },
    "check": {
     "type": "fileContains",
     "path": "/home/etudiant/tp1/notes.txt",
     "text": "Revision Linux"
    }
   },
   {
    "label": {
     "fr": "copie.txt existe dans ~/tp1/a",
     "dar": "copie.txt kayn",
     "en": "copie.txt exists in ~/tp1/a"
    },
    "check": {
     "type": "pathExists",
     "path": "/home/etudiant/tp1/a/copie.txt",
     "kind": "file"
    }
   },
   {
    "label": {
     "fr": "~/brouillon a disparu",
     "dar": "~/brouillon tmse7",
     "en": "~/brouillon is gone"
    },
    "check": {
     "type": "pathExists",
     "path": "/home/etudiant/brouillon",
     "not": true
    }
   }
  ],
  "solution": [
   "mkdir -p ~/tp1/a/b",
   "echo \"Revision Linux\" > ~/tp1/notes.txt",
   "cp ~/tp1/notes.txt ~/tp1/a/copie.txt",
   "rm -rf ~/brouillon"
  ],
  "tp5": []
 },
 {
  "id": "m-tp1-pipes",
  "module": "linux",
  "chapter": "tp1",
  "title": {
   "fr": "Filtres et tubes",
   "dar": "Filtres w pipes",
   "en": "Filters and pipes"
  },
  "goal": {
   "fr": "Écris dans `~/logins.txt` la liste **triée** des logins dont le shell est `/bin/bash`, et dans `~/nb_comptes.txt` le **nombre** de lignes de `/etc/passwd`.",
   "dar": "logins.txt w nb_comptes.txt.",
   "en": "Write the **sorted** bash logins to `~/logins.txt` and the **number** of passwd lines to `~/nb_comptes.txt`."
  },
  "setup": [],
  "startUser": "etudiant",
  "rdbreak": false,
  "engine": "bash",
  "objectives": [
   {
    "label": {
     "fr": "logins.txt contient etudiant puis root",
     "dar": "logins.txt : etudiant w root",
     "en": "logins.txt holds etudiant then root"
    },
    "check": {
     "type": "fileContains",
     "path": "/home/etudiant/logins.txt",
     "text": "etudiant\nroot"
    }
   },
   {
    "label": {
     "fr": "nb_comptes.txt contient 20",
     "dar": "nb_comptes.txt fih 20",
     "en": "nb_comptes.txt contains 20"
    },
    "check": {
     "type": "fileContains",
     "path": "/home/etudiant/nb_comptes.txt",
     "text": "20"
    }
   }
  ],
  "solution": [
   "grep \"/bin/bash$\" /etc/passwd | cut -d: -f1 | sort > ~/logins.txt",
   "cat /etc/passwd | wc -l > ~/nb_comptes.txt"
  ],
  "tp5": []
 },
 {
  "id": "m-grub-timeout",
  "module": "linux",
  "chapter": "grub",
  "title": {
   "fr": "Menu GRUB : 10 secondes",
   "dar": "Menu GRUB : 10 s",
   "en": "GRUB menu: 10 seconds"
  },
  "goal": {
   "fr": "Sauvegarde `/etc/default/grub` (avec `cp -p`) en `grub.bak`, mets `GRUB_TIMEOUT=10` et `GRUB_TIMEOUT_STYLE=menu`, puis régénère grub.cfg. (Éditeur simplifié : `vi /etc/default/grub`, `:r 1 GRUB_TIMEOUT=10` remplace la ligne 1, une ligne tapée est ajoutée, `:wq` enregistre.)",
   "dar": "Sauvegarde, TIMEOUT=10, STYLE=menu, grub2-mkconfig.",
   "en": "Back up with `cp -p`, set `GRUB_TIMEOUT=10` and `GRUB_TIMEOUT_STYLE=menu`, regenerate grub.cfg."
  },
  "setup": [],
  "startUser": "root",
  "rdbreak": false,
  "engine": "bash",
  "objectives": [
   {
    "label": {
     "fr": "Sauvegarde grub.bak présente",
     "dar": "grub.bak kayn",
     "en": "grub.bak backup exists"
    },
    "check": {
     "type": "fileContains",
     "path": "/etc/default/grub.bak",
     "text": "GRUB_TIMEOUT=5"
    }
   },
   {
    "label": {
     "fr": "GRUB_TIMEOUT=10",
     "dar": "GRUB_TIMEOUT=10",
     "en": "GRUB_TIMEOUT=10"
    },
    "check": {
     "type": "fileContains",
     "path": "/etc/default/grub",
     "text": "GRUB_TIMEOUT=10"
    }
   },
   {
    "label": {
     "fr": "GRUB_TIMEOUT_STYLE=menu",
     "dar": "GRUB_TIMEOUT_STYLE=menu",
     "en": "GRUB_TIMEOUT_STYLE=menu"
    },
    "check": {
     "type": "fileContains",
     "path": "/etc/default/grub",
     "text": "GRUB_TIMEOUT_STYLE=menu"
    }
   },
   {
    "label": {
     "fr": "grub.cfg régénéré (timeout=10)",
     "dar": "grub.cfg tjedded",
     "en": "grub.cfg regenerated"
    },
    "check": {
     "type": "fileContains",
     "path": "/boot/grub2/grub.cfg",
     "text": "set timeout=10"
    }
   }
  ],
  "solution": [
   "cp -p /etc/default/grub /etc/default/grub.bak",
   "vi /etc/default/grub",
   ":r 1 GRUB_TIMEOUT=10",
   "GRUB_TIMEOUT_STYLE=menu",
   ":wq",
   "grub2-mkconfig -o /boot/grub2/grub.cfg"
  ],
  "tp5": []
 },
 {
  "id": "m-grub-custom",
  "module": "linux",
  "chapter": "grub",
  "title": {
   "fr": "Entrées « Redemarrer » et « Arreter »",
   "dar": "Entrées Redemarrer w Arreter",
   "en": "\"Redemarrer\" and \"Arreter\" entries"
  },
  "goal": {
   "fr": "Ajoute deux entrées au menu GRUB (redémarrer, arrêter) dans le bon fichier, puis régénère la configuration.",
   "dar": "Zid jouj entrées w 3awed config.",
   "en": "Add two GRUB entries in the right file, then regenerate."
  },
  "setup": [],
  "startUser": "root",
  "rdbreak": false,
  "engine": "bash",
  "objectives": [
   {
    "label": {
     "fr": "Entrées dans 40_custom",
     "dar": "F 40_custom",
     "en": "Entries in 40_custom"
    },
    "check": {
     "type": "fileContains",
     "path": "/etc/grub.d/40_custom",
     "text": "menuentry \"Arreter\""
    }
   },
   {
    "label": {
     "fr": "« Redemarrer » dans grub.cfg",
     "dar": "Redemarrer f grub.cfg",
     "en": "\"Redemarrer\" in grub.cfg"
    },
    "check": {
     "type": "fileContains",
     "path": "/boot/grub2/grub.cfg",
     "text": "menuentry \"Redemarrer\""
    }
   },
   {
    "label": {
     "fr": "« Arreter » dans grub.cfg",
     "dar": "Arreter f grub.cfg",
     "en": "\"Arreter\" in grub.cfg"
    },
    "check": {
     "type": "fileContains",
     "path": "/boot/grub2/grub.cfg",
     "text": "menuentry \"Arreter\""
    }
   }
  ],
  "solution": [
   "echo 'menuentry \"Redemarrer\" { reboot }' >> /etc/grub.d/40_custom",
   "echo 'menuentry \"Arreter\" { halt }' >> /etc/grub.d/40_custom",
   "grub2-mkconfig -o /boot/grub2/grub.cfg"
  ],
  "tp5": []
 },
 {
  "id": "m-root-reset",
  "module": "linux",
  "chapter": "grub",
  "title": {
   "fr": "Réinitialiser le mot de passe root",
   "dar": "Beddel mot de passe root",
   "en": "Reset the root password"
  },
  "goal": {
   "fr": "Tu es au prompt `switch_root:/#` après avoir ajouté `rd.break` dans GRUB. Change le mot de passe root en **`Rev24#Root`** sans casser SELinux, puis termine le démarrage.",
   "dar": "F `switch_root:/#`. Beddel root l `Rev24#Root`.",
   "en": "You are at `switch_root:/#` after `rd.break`. Set root's password to **`Rev24#Root`** without breaking SELinux, then finish booting."
  },
  "setup": [],
  "startUser": "root",
  "rdbreak": true,
  "engine": "bash",
  "objectives": [
   {
    "label": {
     "fr": "Mot de passe root = Rev24#Root",
     "dar": "Mot de passe root = Rev24#Root",
     "en": "root password = Rev24#Root"
    },
    "check": {
     "type": "password",
     "user": "root",
     "password": "Rev24#Root"
    }
   },
   {
    "label": {
     "fr": "Réétiquetage SELinux effectué",
     "dar": "Relabel SELinux tdar",
     "en": "SELinux relabel done"
    },
    "check": {
     "type": "flag",
     "flag": "relabeled"
    }
   }
  ],
  "solution": [
   "mount -o remount,rw /sysroot",
   "chroot /sysroot",
   "passwd",
   "Rev24#Root",
   "Rev24#Root",
   "touch /.autorelabel",
   "exit",
   "exit"
  ],
  "tp5": []
 },
