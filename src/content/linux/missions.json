 {
  "id": "m-dnf-local-repo",
  "module": "linux",
  "chapter": "paquets",
  "title": {
   "fr": "Dépôt local",
   "dar": "Dépôt local",
   "en": "Local repository"
  },
  "goal": {
   "fr": "Crée un dépôt local `/var/www/html/mon_depot` contenant `zsh`, déclare-le dans `local.repo`, désactive les deux dépôts Red Hat puis installe zsh.",
   "dar": "Dépôt local + zsh.",
   "en": "Create a local repo with zsh, declare it, disable Red Hat repos, install zsh."
  },
  "setup": [],
  "startUser": "root",
  "rdbreak": false,
  "engine": "bash",
  "objectives": [
   {
    "label": {
     "fr": "Métadonnées générées (repodata)",
     "dar": "repodata",
     "en": "Metadata generated"
    },
    "check": {
     "type": "pathExists",
     "path": "/var/www/html/mon_depot/repodata",
     "kind": "dir"
    }
   },
   {
    "label": {
     "fr": "local.repo correct",
     "dar": "local.repo",
     "en": "local.repo correct"
    },
    "check": {
     "type": "fileContains",
     "path": "/etc/yum.repos.d/local.repo",
     "text": "baseurl=file:///var/www/html/mon_depot"
    }
   },
   {
    "label": {
     "fr": "Dépôt AppStream désactivé",
     "dar": "AppStream mtfi",
     "en": "AppStream disabled"
    },
    "check": {
     "type": "fileContains",
     "path": "/etc/yum.repos.d/redhat.repo",
     "text": "enabled = 0"
    }
   },
   {
    "label": {
     "fr": "zsh installé",
     "dar": "zsh installé",
     "en": "zsh installed"
    },
    "check": {
     "type": "packageInstalled",
     "name": "zsh",
     "installed": true
    }
   }
  ],
  "solution": [
   "dnf install -y httpd createrepo_c",
   "mkdir -p /var/www/html/mon_depot",
   "dnf install --downloadonly --downloaddir=/var/www/html/mon_depot -y zsh",
   "createrepo /var/www/html/mon_depot",
   "echo -e \"[local]\\nname=Depot local\\nbaseurl=file:///var/www/html/mon_depot\\ngpgcheck=0\\nenabled=1\" > /etc/yum.repos.d/local.repo",
   "yum-config-manager --disable rhel-9-for-x86_64-baseos-rpms",
   "yum-config-manager --disable rhel-9-for-x86_64-appstream-rpms",
   "dnf repolist",
   "dnf install -y zsh"
