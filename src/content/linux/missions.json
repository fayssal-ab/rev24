[
 {
  "id": "m-grub-timeout",
  "module": "linux",
  "chapter": "grub",
  "title": {
   "fr": "Menu GRUB : 10 secondes",
   "dar": "Menu GRUB : 10 s",
   "en": "GRUB menu: 10 seconds"
  },
  "goal": {
   "fr": "Sauvegarde `/etc/default/grub` (avec `cp -p`) en `grub.bak`, mets `GRUB_TIMEOUT=10` et `GRUB_TIMEOUT_STYLE=menu`, puis régénère grub.cfg. (Éditeur simplifié : `vi /etc/default/grub`, `:r 1 GRUB_TIMEOUT=10` remplace la ligne 1, une ligne tapée est ajoutée, `:wq` enregistre.)",
   "dar": "Sauvegarde, TIMEOUT=10, STYLE=menu, grub2-mkconfig.",
   "en": "Back up with `cp -p`, set `GRUB_TIMEOUT=10` and `GRUB_TIMEOUT_STYLE=menu`, regenerate grub.cfg."
  },
  "setup": [],
  "startUser": "root",
  "rdbreak": false,
  "engine": "bash",
  "objectives": [
   {
    "label": {
     "fr": "Sauvegarde grub.bak présente",
     "dar": "grub.bak kayn",
     "en": "grub.bak backup exists"
    },
    "check": {
     "type": "fileContains",
     "path": "/etc/default/grub.bak",
     "text": "GRUB_TIMEOUT=5"
    }
   },
   {
    "label": {
     "fr": "GRUB_TIMEOUT=10",
     "dar": "GRUB_TIMEOUT=10",
     "en": "GRUB_TIMEOUT=10"
    },
    "check": {
     "type": "fileContains",
     "path": "/etc/default/grub",
     "text": "GRUB_TIMEOUT=10"
    }
   },
   {
    "label": {
     "fr": "GRUB_TIMEOUT_STYLE=menu",
     "dar": "GRUB_TIMEOUT_STYLE=menu",
     "en": "GRUB_TIMEOUT_STYLE=menu"
    },
    "check": {
     "type": "fileContains",
     "path": "/etc/default/grub",
     "text": "GRUB_TIMEOUT_STYLE=menu"
    }
   },
   {
    "label": {
     "fr": "grub.cfg régénéré (timeout=10)",
     "dar": "grub.cfg tjedded",
     "en": "grub.cfg regenerated"
    },
    "check": {
     "type": "fileContains",
     "path": "/boot/grub2/grub.cfg",
     "text": "set timeout=10"
    }
   }
  ],
  "solution": [
   "cp -p /etc/default/grub /etc/default/grub.bak",
   "vi /etc/default/grub",
   ":r 1 GRUB_TIMEOUT=10",
   "GRUB_TIMEOUT_STYLE=menu",
   ":wq",
   "grub2-mkconfig -o /boot/grub2/grub.cfg"
  ],
  "tp5": []
 },
 {
  "id": "m-grub-custom",
  "module": "linux",
  "chapter": "grub",
  "title": {
   "fr": "Entrées « Redemarrer » et « Arreter »",
   "dar": "Entrées Redemarrer w Arreter",
   "en": "\"Redemarrer\" and \"Arreter\" entries"
  },
  "goal": {
   "fr": "Ajoute deux entrées au menu GRUB (redémarrer, arrêter) dans le bon fichier, puis régénère la configuration.",
   "dar": "Zid jouj entrées w 3awed config.",
   "en": "Add two GRUB entries in the right file, then regenerate."
  },
  "setup": [],
  "startUser": "root",
  "rdbreak": false,
  "engine": "bash",
  "objectives": [
   {
    "label": {
     "fr": "Entrées dans 40_custom",
     "dar": "F 40_custom",
     "en": "Entries in 40_custom"
    },
    "check": {
     "type": "fileContains",
     "path": "/etc/grub.d/40_custom",
     "text": "menuentry \"Arreter\""
    }
   },
   {
    "label": {
     "fr": "« Redemarrer » dans grub.cfg",
     "dar": "Redemarrer f grub.cfg",
     "en": "\"Redemarrer\" in grub.cfg"
    },
    "check": {
     "type": "fileContains",
     "path": "/boot/grub2/grub.cfg",
     "text": "menuentry \"Redemarrer\""
    }
   },
   {
    "label": {
     "fr": "« Arreter » dans grub.cfg",
     "dar": "Arreter f grub.cfg",
     "en": "\"Arreter\" in grub.cfg"
    },
    "check": {
     "type": "fileContains",
     "path": "/boot/grub2/grub.cfg",
     "text": "menuentry \"Arreter\""
    }
   }
  ],
  "solution": [
   "echo 'menuentry \"Redemarrer\" { reboot }' >> /etc/grub.d/40_custom",
   "echo 'menuentry \"Arreter\" { halt }' >> /etc/grub.d/40_custom",
   "grub2-mkconfig -o /boot/grub2/grub.cfg"
  ],
  "tp5": []
 },
 {
  "id": "m-root-reset",
  "module": "linux",
  "chapter": "grub",
  "title": {
   "fr": "Réinitialiser le mot de passe root",
   "dar": "Beddel mot de passe root",
   "en": "Reset the root password"
  },
  "goal": {
   "fr": "Tu es au prompt `switch_root:/#` après avoir ajouté `rd.break` dans GRUB. Change le mot de passe root en **`Rev24#Root`** sans casser SELinux, puis termine le démarrage.",
   "dar": "F `switch_root:/#`. Beddel root l `Rev24#Root`.",
   "en": "You are at `switch_root:/#` after `rd.break`. Set root's password to **`Rev24#Root`** without breaking SELinux, then finish booting."
  },
  "setup": [],
  "startUser": "root",
  "rdbreak": true,
  "engine": "bash",
  "objectives": [
   {
    "label": {
     "fr": "Mot de passe root = Rev24#Root",
     "dar": "Mot de passe root = Rev24#Root",
     "en": "root password = Rev24#Root"
    },
    "check": {
     "type": "password",
     "user": "root",
     "password": "Rev24#Root"
    }
   },
   {
    "label": {
     "fr": "Réétiquetage SELinux effectué",
     "dar": "Relabel SELinux tdar",
     "en": "SELinux relabel done"
    },
    "check": {
     "type": "flag",
     "flag": "relabeled"
    }
   }
  ],
  "solution": [
   "mount -o remount,rw /sysroot",
   "chroot /sysroot",
   "passwd",
   "Rev24#Root",
   "Rev24#Root",
   "touch /.autorelabel",
   "exit",
   "exit"
  ],
  "tp5": []
 },
 {
  "id": "m-systemd-target",
  "module": "linux",
  "chapter": "systemd",
  "title": {
   "fr": "Passer en mode texte",
   "dar": "Douz l mode texte",
   "en": "Switch to text mode"
  },
  "goal": {
   "fr": "Passe **immédiatement** en `multi-user.target` et fais-en la cible **par défaut**.",
   "dar": "Daba multi-user w par défaut.",
   "en": "Switch **now** to `multi-user.target` and make it the **default**."
  },
  "setup": [],
  "startUser": "root",
  "rdbreak": false,
  "engine": "bash",
  "objectives": [
   {
    "label": {
     "fr": "Cible par défaut = multi-user.target",
     "dar": "Default = multi-user",
     "en": "Default = multi-user.target"
    },
    "check": {
     "type": "defaultTarget",
     "target": "multi-user.target"
    }
   },
   {
    "label": {
     "fr": "Interface graphique arrêtée (isolate)",
     "dar": "gdm wa9ef",
     "en": "GUI stopped (isolate)"
    },
    "check": {
     "type": "serviceState",
     "service": "gdm",
     "active": false
    }
   }
  ],
  "solution": [
   "systemctl set-default multi-user.target",
   "systemctl isolate multi-user.target"
  ],
  "tp5": []
 },
 {
  "id": "m-systemd-enable",
  "module": "linux",
  "chapter": "systemd",
  "title": {
   "fr": "Services : enable, start, mask",
   "dar": "Services",
   "en": "Services: enable, start, mask"
  },
  "goal": {
   "fr": "Installe le serveur web `httpd`, démarre-le et active-le au démarrage en une commande ; interdis complètement `bluetooth`.",
   "dar": "httpd enable --now ; mask bluetooth.",
   "en": "Install `httpd`, start+enable it in one command; fully forbid `bluetooth`."
  },
  "setup": [],
  "startUser": "root",
  "rdbreak": false,
  "engine": "bash",
  "objectives": [
   {
    "label": {
     "fr": "httpd installé",
     "dar": "httpd installé",
     "en": "httpd installed"
    },
    "check": {
     "type": "packageInstalled",
     "name": "httpd",
     "installed": true
    }
   },
   {
    "label": {
     "fr": "httpd actif et activé",
     "dar": "httpd active w enabled",
     "en": "httpd active and enabled"
    },
    "check": {
     "type": "serviceState",
     "service": "httpd",
     "active": true,
     "enabled": true
    }
   },
   {
    "label": {
     "fr": "bluetooth masqué",
     "dar": "bluetooth masqué",
     "en": "bluetooth masked"
    },
    "check": {
     "type": "serviceState",
     "service": "bluetooth",
     "masked": true
    }
   }
  ],
  "solution": [
   "dnf install -y httpd",
   "systemctl enable --now httpd",
   "systemctl mask bluetooth"
  ],
  "tp5": []
 },
 {
  "id": "m-systemd-service",
  "module": "linux",
  "chapter": "systemd",
  "title": {
   "fr": "Créer le service hello",
   "dar": "Service hello",
   "en": "Create the hello service"
  },
  "goal": {
   "fr": "Crée le script exécutable `/usr/local/bin/hello.sh`, l'unité `/etc/systemd/system/hello.service` (Description, ExecStart, WantedBy=multi-user.target), recharge systemd, active et démarre le service.",
   "dar": "Script + unité + daemon-reload + enable --now.",
   "en": "Create the executable script, the unit file, reload systemd, enable and start."
  },
  "setup": [],
  "startUser": "root",
  "rdbreak": false,
  "engine": "bash",
  "objectives": [
   {
    "label": {
     "fr": "Script exécutable (755)",
     "dar": "Script 755",
     "en": "Executable script (755)"
    },
    "check": {
     "type": "mode",
     "path": "/usr/local/bin/hello.sh",
     "mode": "755"
    }
   },
   {
    "label": {
     "fr": "Fichier d'unité présent",
     "dar": "Unité kayna",
     "en": "Unit file present"
    },
    "check": {
     "type": "fileContains",
     "path": "/etc/systemd/system/hello.service",
     "text": "WantedBy=multi-user.target"
    }
   },
   {
    "label": {
     "fr": "hello actif et activé",
     "dar": "hello active w enabled",
     "en": "hello active and enabled"
    },
    "check": {
     "type": "serviceState",
     "service": "hello",
     "active": true,
     "enabled": true
    }
   }
  ],
  "solution": [
   "echo -e \"#!/bin/bash\\necho hello\" > /usr/local/bin/hello.sh",
   "chmod +x /usr/local/bin/hello.sh",
   "echo -e \"[Unit]\\nDescription=Hello\\n\\n[Service]\\nExecStart=/usr/local/bin/hello.sh\\n\\n[Install]\\nWantedBy=multi-user.target\" > /etc/systemd/system/hello.service",
   "systemctl daemon-reload",
   "systemctl enable --now hello"
  ],
  "tp5": []
 }
]
